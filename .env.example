# Strand secrets — copy to ~/.strand/.env (created by `strand config init`)
# For Docker Compose you may also place a root `.env` for publish ports / proxies.
# Do not commit real values.

JWT_SECRET=replace-with-openssl-rand-base64-48
STRAND_API_TOKEN=replace-with-random-token

# Optional overrides (local)
# STRAND_API_PORT=8080
# STRAND_API_HOST=127.0.0.1
# STRAND_CONFIG=~/.strand/config.toml

# Docker Compose publish ports
# STRAND_API_PUBLISH=8080
# STRAND_WEB_PUBLISH=3000
# STRAND_VERSION=0.1.0

# Outbound proxy (OpenAI / some CEX endpoints)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Database (postgres)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=strand
# DB_SSLMODE=disable

# Market data
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# TWELVE_DATA_KEY=

# Messaging
# WEIXIN_TOKEN=
# TELEGRAM_BOT_TOKEN=
